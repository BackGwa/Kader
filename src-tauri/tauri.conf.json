{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kader",
  "version": "1.0.0",
  "identifier": "dev.backgwa.kader",
  "build": {
    "beforeDevCommand": "pnpm engines && pnpm dev",
    "beforeBuildCommand": "pnpm engines && pnpm build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Kader",
        "width": 900,
        "height": 600,
        "minWidth": 680,
        "minHeight": 460,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 19, "y": 21 }
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' https: data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "category": "Utility",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "12.3"
    }
  }
}
